DATABASE_URL=postgres://user:pass@localhost:5432/internship_desk

# Who can reach the desk (proxy.ts). It listens on 127.0.0.1 only and answers only requests addressed to this machine.
# DESK_ALLOWED_HOSTS=                 # more Host names to accept, comma-separated (e.g. the PC's name on your LAN)
# DESK_ACCESS_TOKEN=                  # require opening /?token=<value> once per browser; set it before serving beyond 127.0.0.1

# Gmail OAuth (readonly + compose only — never gmail.send by default)
# Account used for drafts + inbox sync:
GMAIL_USER_EMAIL=ara.ghahramanyan07@gmail.com
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://127.0.0.1:53682/oauth2callback
# Assisted Mode (default on). Approve creates a Gmail draft unless send is allowed:
ASSISTED_MODE=true
#GMAIL_ALLOW_SEND=true   # only if you re-auth with gmail.send scope

# Optional desk chrome identity (defaults derived from DESK_OWNER_NAME / Gmail)
# DESK_OWNER_NAME=Ara Ghahramanyan
# DESK_OWNER_SHORT=Ara G.
# DESK_OWNER_EMAIL=ara.ghahramanyan07@gmail.com
# DESK_OWNER_INITIALS=AG

# Optional: LinkedIn + Indeed, each via your own Apify actor — public
# listings only, no login used on either platform, left unset = skipped
# (no fake results). Pick actors that read public job pages without
# cookies/session (see README). Indeed has no official API of its own
# (retired 2023) — this Apify route is the only way it works at all.
# APIFY_TOKEN=
# APIFY_LINKEDIN_JOBS_ACTOR=
# Comma-separated = one actor run per term, merged + deduped:
# APIFY_LINKEDIN_SEARCH_QUERY=software engineering intern, backend intern, full stack intern
# APIFY_LINKEDIN_SEARCH_LOCATION=Montreal, Quebec, Canada
# APIFY_LINKEDIN_JOBS_INPUT={}   # full actor input as JSON, overrides the two above
# APIFY_INDEED_JOBS_ACTOR=
# APIFY_INDEED_SEARCH_QUERY=software engineering intern, backend intern, full stack intern
# APIFY_INDEED_SEARCH_LOCATION=Montreal, Quebec, Canada
# APIFY_INDEED_JOBS_INPUT={}     # full actor input as JSON, overrides the two above

# The CV match reads each posting's text, and LinkedIn's actor returns it only when it opens every listing.
# That is the default; false = faster and cheaper, but LinkedIn postings then match on their title alone.
# APIFY_SCRAPE_DETAILS=false

# Which results count as relevant, and the auto-track cutoff: filters.json

# Optional: enrich company dossiers (falls back to heuristic research)
# and draft written answers on online application forms (lib/apply).
ANTHROPIC_API_KEY=
# The model is chosen by how hard the task is (lib/claude.ts). A hard one (a company-specific answer, a long
# or open one) uses the strong model; an easy one (strengths, teamwork, a short answer, company research)
# starts on the cheap model, and the strong one is only called in when the cheap draft fails the desk's checks.
# ANTHROPIC_MODEL_HARD=claude-sonnet-5-5
# ANTHROPIC_MODEL_EASY=claude-haiku-4-5-20251001
# ANTHROPIC_EFFORT=high                    # strong model: low | medium | high | xhigh | max (Haiku takes none)
# One model for everything: set ANTHROPIC_MODEL_EASY to the same value as ANTHROPIC_MODEL_HARD.
# Pin a whole use to one model, whatever the task:
# ANTHROPIC_ANSWER_MODEL=                  # written form answers
# ANTHROPIC_RESEARCH_MODEL=                # company research

# Portal applications (postings with no published contact): schema-v11.sql, npm run portal.
# Reading forms and drafting answers is on; submitting is OFF until you set this.
# PORTAL_ALLOW_SUBMIT=true            # submit only when every preflight gate passes
# PORTAL_AUTO_APPROVE_ANSWERS=false   # true = drafts that pass every check skip your approval
# PORTAL_AUTO_CONFIRM_PERSONAL=false  # true = personal answers from your bank (work authorization, sponsorship, required
#                                     # self-identification, salary) need no click, and a required box that only consents to
#                                     # the application itself (privacy notice, "information is accurate") is ticked
# Multi-step forms (schema-v14.sql) are filled page by page; Workday's wizard stays yours.
# PORTAL_AUTO_PLAN=true               # automate: read forms + draft answers after each discover
# PORTAL_DAILY_LIMIT=10               # max automatic submissions per day
# PORTAL_DELAY_SECONDS=90             # pause between applications in a queue
# PORTAL_COVER_LETTER=required        # "always" = attach the letter even when optional
# CAREERS_LOOKUP=false                # skip looking for a LinkedIn/Indeed role on the company's own careers site

# Employer portals that ask for an account (Workday, iCIMS...): a run for ONE application may sign in or create it.
# Real values go in .env.local only (gitignored). Use a password you use nowhere else. See "Employer portal accounts".
# PORTAL_CREATE_ACCOUNTS=true
# PORTAL_ACCOUNT_EMAIL=
# PORTAL_ACCOUNT_PASSWORD=
# The password is typed only over https on a known application system (Workday, iCIMS, Taleo...). An employer's own
# account portal must be listed here first (comma-separated, subdomains included):
# PORTAL_ACCOUNT_HOSTS=careers.example.com
# A portal whose printed password rules the password above does not meet gets a password of its own, generated to meet
# them and kept encrypted (AES-256-GCM) in a vault file outside the project. Without this key that portal stops instead.
# Any long random string (e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"):
# PORTAL_VAULT_KEY=
# PORTAL_VAULT_PATH=                   # default: ~/.internship-desk/portal-vault.json

# "Postuler automatiquement" (schema-v13.sql, npm run auto-apply): apply to the N best-scored postings.
# Emails become Gmail drafts you send; online forms are submitted only with PORTAL_ALLOW_SUBMIT=true (above).
# AUTO_APPLY_MIN_SCORE=60             # lowest match score (percent) the batch will apply to
# AUTO_APPLY_MIN_GRADE=3              # fit review (schema-v16.sql): skip postings a reviewer grades under this (1-5); 0 = no review
# PORTAL_BATCH_ACCOUNTS=false         # true = the batch may also sign in to / create Workday-style accounts (PORTAL_ACCOUNT_* above)

# Auto-apply v2 (schema-v16.sql)
# PORTAL_AI_AGENT=true                # the AI form agent fills portals the desk's own reader cannot (Workday, SuccessFactors,
#                                     # first-step portals). On by default with ANTHROPIC_API_KEY. It never presses the final
#                                     # Submit, never types a password, never solves a CAPTCHA.
# PORTAL_AI_AGENT_MAX_ACTIONS=90      # actions per application before it stops and hands over
# ANTHROPIC_AGENT_MODEL=              # pin the agent's model (default: the strong model)
# ANTHROPIC_REVIEW_MODEL=             # pin the fit review's model (default: the cheap model)
# CV_TAILORED=false                   # true = emails and forms carry the CV reordered for each posting (lib/cv-tailor.ts)
# ANTHROPIC_CV_MODEL=                 # pin the tailoring model (default: the cheap model)

# LinkedIn Easy Apply (npm run linkedin:setup, then npm run linkedin). Runs GodsScion/Auto_job_applier_linkedIn
# from tools/linkedin-bot with your LinkedIn account, in a visible Chrome window. LinkedIn's terms forbid bots on an
# account: keep runs small. Everything else (name, phone, links, authorization, CV) comes from the desk.
# Typed into every salary question (yearly, CAD). Required, except for --dry:
# LINKEDIN_DESIRED_SALARY=
# LINKEDIN_SEARCH_TERMS=Software Developer Intern,Stagiaire développeur logiciel
# LINKEDIN_SEARCH_LOCATION=Montreal, Quebec, Canada
# LINKEDIN_PER_SEARCH=15             # applications per search term before moving to the next
# LINKEDIN_CONFIDENCE_LEVEL=6        # "on a scale of 1-10" questions
# Leave unset to sign in yourself in the bot's window (it stays signed in). Set both to have it type them:
# LINKEDIN_EMAIL=
# LINKEDIN_PASSWORD=
# Careers page first (schema-v17.sql, npm run daily; npm run automate runs it every morning).
# Who presses Submit on a filled careers form: approve = you, on /approvals (default); auto = the desk when every
# preflight gate passes (what PORTAL_ALLOW_SUBMIT=true meant, still read when this is unset); off = nobody.
# PORTAL_SUBMIT=approve
# APPLY_EMAIL_FALLBACK=false          # true = email a published recruiter address when no careers form can be filled
# DAILY_APPLY_COUNT=10                # careers forms filled per daily run, left for your approval
# DAILY_AT=0 9 * * *                  # when automate runs the daily careers pass (cron); the scheduled task uses 9:00 too
# DAILY_UNTIL=15:00                   # the daily pass keeps filling forms until this time (or until the tokens are finished)
# DAILY_TOKEN_BUDGET=                 # most Claude tokens (in + out) one daily pass may use; unset = until the account's credit runs out
# AUTO_APPLY_LEVEL_BLOCKS=false       # true = the fit review skips a posting asking for a bachelor's (default: college first, apply everywhere)
# FREEHIRE_COUNTRIES=CA               # freehire.me search: where the internships are (ISO codes, comma-separated)
# FREEHIRE_QUERIES=intern internship stage stagiaire co-op coop   # title words; one search per comma-separated entry

# Muse (Meta's assistant) through a Muse gadget: a Raspberry Pi running the Muse Gadget SDK plus muse/desk_bridge.py.
# The daily run and the inbox sync tell Muse what happened; Muse answers "what's on my desk?" from desk-status on the Pi.
# Off unless both are set; muse/install.sh prints them. See muse/README.md.
# MUSE_BRIDGE_URL=http://192.168.1.50:8788
# MUSE_BRIDGE_TOKEN=
# DESK_PUBLIC_URL=http://127.0.0.1:3001   # the desk's address as written in Muse messages (the /approvals link)
